# Copy this file to .env and fill in your own values before running the server

# Port the API server runs on
PORT=5000

# Secret used to sign admin login tokens — change this to a long random string
JWT_SECRET=change_this_to_a_long_random_secret

# Default admin login (used only the first time the server starts, to create the admin account)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# Allowed origin for the frontend (set to your deployed frontend URL in production)
CLIENT_ORIGIN=http://localhost:5173
